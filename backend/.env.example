# ==============================================================================
# AdPilot Backend Environment Variables
# ==============================================================================
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
AGENT_SERVICE_URL=http://localhost:8000
ENABLE_VIDEO_GENERATION=false

# MongoDB Configuration
MONGODB_URI=mongodb://adpilot_user:adpilot_password@localhost:27017/adpilot?authSource=adpilot

# Redis Configuration (Queue & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=adpilot_redis_pass
REDIS_URL=redis://:adpilot_redis_pass@localhost:6379/0

# MinIO / S3 Object Storage Configuration
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=adpilot_minio_user
STORAGE_SECRET_KEY=adpilot_minio_secret_key
STORAGE_BUCKET_CREATIVES=adpilot-creatives
STORAGE_BUCKET_ASSETS=adpilot-assets
STORAGE_BUCKET_TEMP=adpilot-temp
STORAGE_FORCE_PATH_STYLE=true
