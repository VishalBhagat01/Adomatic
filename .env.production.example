# ============================================
# AdPilot AI - Production Environment Template
# Copy to .env.production and supply secrets via your vault / CI secret manager.
# NEVER commit populated secrets to version control.
# ============================================

NODE_ENV=production
PORT=5000
FRONTEND_PORT=80
CORS_ORIGIN=https://studio.example.com
LOG_LEVEL=info

# MongoDB (Use strong unique credentials / Atlas URI)
MONGO_INITDB_ROOT_USERNAME=replace_mongo_root_user
MONGO_INITDB_ROOT_PASSWORD=replace_strong_mongo_root_password
MONGO_INITDB_DATABASE=adpilot
MONGODB_URI=mongodb://adpilot_user:adpilot_password@mongodb:27017/adpilot?authSource=adpilot

# Redis (BullMQ & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_strong_redis_password
REDIS_URL=redis://:replace_strong_redis_password@redis:6379/0

# S3 / MinIO Object Storage
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace_minio_access_key
STORAGE_SECRET_KEY=replace_strong_minio_secret_key
STORAGE_BUCKET_CREATIVES=adpilot-creatives
STORAGE_BUCKET_ASSETS=adpilot-assets
STORAGE_BUCKET_TEMP=adpilot-temp
STORAGE_FORCE_PATH_STYLE=true

# Google Gemini & Veo AI Service
GEMINI_API_KEY=replace_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_IMAGE_ESTIMATED_COST_USD=0.039
GEMINI_VIDEO_COST_PER_SECOND_USD=0.10
EVALUATION_APPROVAL_THRESHOLD=75.0

# Meta Marketing API (Production Security Guardrails)
META_GRAPH_API_VERSION=v27.0
META_APP_ID=replace_meta_app_id
META_APP_SECRET=replace_meta_app_secret
META_REDIRECT_URI=https://studio.example.com/api/meta/oauth/callback
META_FRONTEND_CALLBACK_URL=https://studio.example.com/settings
META_TOKEN_ENCRYPTION_KEY=replace_with_32_byte_base64_or_hex_secret
META_INSIGHTS_DEFAULT_ATTRIBUTION_WINDOWS=7d_click,1d_view
META_RATE_LIMIT_PAUSE_THRESHOLD=80
META_ALLOW_FIXTURE_SYNC=false

