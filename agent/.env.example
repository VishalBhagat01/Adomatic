PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Infrastructure
REDIS_URL=redis://:adpilot_redis_pass@localhost:6379/0
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=adpilot_minio_user
STORAGE_SECRET_KEY=adpilot_minio_secret_key
STORAGE_BUCKET_CREATIVES=adpilot-creatives
STORAGE_BUCKET_ASSETS=adpilot-assets
STORAGE_BUCKET_TEMP=adpilot-temp

# Multi-Provider LLM Configuration (Groq for structured text/vision + Gemini fallback & image gen)
LLM_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_FALLBACK_MODELS=
GROQ_MAX_VISION_IMAGES=2
GROQ_TIMEOUT_SECONDS=45.0
GROQ_MAX_RETRIES=2
ENABLE_VIDEO_GENERATION=false

# Gemini AI Configuration (Required for Step 05+ live inference & image generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45.0
GEMINI_MAX_RETRIES=2
GEMINI_MAX_REGENERATIONS=2

# Image Generation Configuration (Step 07 + Free Fallback Providers)
IMAGE_PROVIDER=auto
POLLINATIONS_MODEL=flux
HF_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_GEN_TIMEOUT_SECONDS=60.0
IMAGE_GEN_MAX_RETRIES=2
IMAGE_MIN_WIDTH=512
IMAGE_MIN_HEIGHT=512
IMAGE_MAX_REFERENCE_IMAGES=3
GEMINI_IMAGE_ESTIMATED_COST_USD=0.039

# Gemini Veo Video Generation & FFmpeg Configuration (Step 08)
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_VIDEO_FPS=24
GEMINI_VIDEO_GENERATE_AUDIO=true
GEMINI_VIDEO_COST_PER_SECOND_USD=0.10
VIDEO_JOB_POLL_INTERVAL_SECONDS=10.0
VIDEO_JOB_MAX_POLL_ATTEMPTS=30

# Creative Evaluation & Ad Copy Configuration (Step 09)
EVALUATION_APPROVAL_THRESHOLD=75.0
EVALUATION_MAX_REGENERATIONS=2
