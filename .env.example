# ==============================================================================
# AdPilot AI - Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env or use individual .env files in each service directory.
# NEVER commit production secrets or actual API keys to source control.

COMPOSE_PROJECT_NAME=adpilot-ai

# ------------------------------------------------------------------------------
# Infrastructure Credentials (Local Development)
# ------------------------------------------------------------------------------
# MongoDB
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=adpilot_mongo_admin
MONGO_DATABASE=adpilot
MONGO_APP_USER=adpilot_user
MONGO_APP_PASSWORD=adpilot_password
MONGODB_URI=mongodb://adpilot_user:adpilot_password@localhost:27017/adpilot?authSource=adpilot

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=adpilot_redis_pass
REDIS_URL=redis://:adpilot_redis_pass@localhost:6379/0

# MinIO (S3 Compatible Storage)
MINIO_ROOT_USER=adpilot_minio_user
MINIO_ROOT_PASSWORD=adpilot_minio_secret_key
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=adpilot_minio_user
STORAGE_SECRET_KEY=adpilot_minio_secret_key
STORAGE_BUCKET_CREATIVES=adpilot-creatives
STORAGE_BUCKET_ASSETS=adpilot-assets
STORAGE_BUCKET_TEMP=adpilot-temp
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# Frontend Service Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_BACKEND_URL=http://localhost:5000
VITE_AGENT_URL=http://localhost:8000
VITE_ENABLE_VIDEO_GENERATION=false

# ------------------------------------------------------------------------------
# Backend Service Configuration (Node.js / Express)
# ------------------------------------------------------------------------------
BACKEND_PORT=5000
NODE_ENV=development
BACKEND_CORS_ORIGIN=http://localhost:5173
BACKEND_LOG_LEVEL=info
AGENT_SERVICE_URL=http://localhost:8000
ENABLE_VIDEO_GENERATION=false

# ------------------------------------------------------------------------------
# Agent Service Configuration (Python / FastAPI)
# ------------------------------------------------------------------------------
AGENT_PORT=8000
AGENT_HOST=0.0.0.0
AGENT_ENV=development
AGENT_LOG_LEVEL=INFO
AGENT_CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Multi-Provider LLM Configuration (Groq for structured text/vision + Gemini fallback & image gen)
LLM_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_FALLBACK_MODELS=
GROQ_MAX_VISION_IMAGES=2
GROQ_TIMEOUT_SECONDS=45.0
GROQ_MAX_RETRIES=2
ENABLE_VIDEO_GENERATION=false

# Gemini AI Configuration (Required for AI Product Strategy & Creative Workflows)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45.0
GEMINI_MAX_RETRIES=2
GEMINI_MAX_REGENERATIONS=2
# Image Generation Configuration (auto = Gemini -> HuggingFace -> Pollinations -> Pillow fallback)
IMAGE_PROVIDER=auto
POLLINATIONS_MODEL=flux
HF_API_KEY=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_GEN_TIMEOUT_SECONDS=60.0
IMAGE_GEN_MAX_RETRIES=2
GEMINI_IMAGE_ESTIMATED_COST_USD=0.039
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
GEMINI_VIDEO_RESOLUTION=720p
GEMINI_VIDEO_COST_PER_SECOND_USD=0.10
EVALUATION_APPROVAL_THRESHOLD=75.0
EVALUATION_MAX_REGENERATIONS=2

# ------------------------------------------------------------------------------
# Meta Marketing API Integration (Backend Only - Never Expose Tokens to Client)
# ------------------------------------------------------------------------------
META_GRAPH_API_VERSION=v27.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/meta/oauth/callback
META_FRONTEND_CALLBACK_URL=http://localhost:5173/settings
META_TOKEN_ENCRYPTION_KEY=replace_with_32_plus_char_secret_for_aes_256_gcm
META_INSIGHTS_DEFAULT_ATTRIBUTION_WINDOWS=7d_click,1d_view
META_RATE_LIMIT_PAUSE_THRESHOLD=80
META_ALLOW_FIXTURE_SYNC=true
